<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (this app targets API 31+).
     No app data is eligible for backup: files/plugins contains executable scripts;
     shared_prefs/project_state.xml contains device-specific SAF references;
     app_webview contains plugin sources and approvals alongside UI preferences.
     XML rules cannot separate localStorage keys, so UI preferences stay local too.
     Existing on-device data is preserved; no storage migration is performed.
     https://developer.android.com/identity/data/autobackup -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
