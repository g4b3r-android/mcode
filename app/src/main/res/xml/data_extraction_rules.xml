<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same local-only policy as backup_rules.xml, for both transports.
     Exclude executable plugins, approvals, WebView data and SAF project references.
     UI preferences share WebView storage with plugins, so they are not transferred.
     A separate settings-only store would be needed before enabling safe backup.
     Explicit device-transfer rules are required on devices that ignore allowBackup.
     https://developer.android.com/identity/data/autobackup -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
